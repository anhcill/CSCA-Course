# Database and app session
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15d
PORT=8888
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false

# Keep false outside a private local debugging session. Codes must never be
# logged in production.
AUTH_DEBUG_CODES=false

# meet.jit.si is allowed by default. Set one host or a comma-separated list
# when the school moves to a private/self-hosted Jitsi deployment.
JITSI_HOST=
JITSI_ALLOWED_HOSTS=

# Google OAuth (Web application). Keep all four values blank to deploy with
# Google sign-in disabled; set all four together to enable account activation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8888/api/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=

# InternalManagement -> LMS server-to-server integration. Generate independent
# high-entropy values and store production values in secret management only.
MANAGEMENT_INTEGRATION_SERVICE_TOKEN=
MANAGEMENT_INTEGRATION_KEY=
MANAGEMENT_INTEGRATION_HMAC_SECRET=
MANAGEMENT_INTEGRATION_MAX_AGE_SECONDS=300

# Separate Railway worker for durable Management -> LMS projection. Keep this
# worker on the same database but deploy it as its own service/process.
LMS_SYNC_WORKER_ID=
LMS_SYNC_WORKER_POLL_MS=3000
LMS_SYNC_WORKER_BATCH_SIZE=10
LMS_SYNC_JOB_LOCK_SECONDS=900

# LMS -> InternalManagement attendance. Both values are mandatory in production.
# The same HMAC secret must be set as CredentialReference for the
# CSCA_COURSE_LMS IntegrationSource inside InternalManagement.
MANAGEMENT_ATTENDANCE_WEBHOOK_URL=
MANAGEMENT_ATTENDANCE_WEBHOOK_SECRET=

# Cloudflare R2 private LMS files/videos/images (zero egress bandwidth)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_S3_ENDPOINT=
R2_FILE_UPLOAD_URL_TTL_SECONDS=900
R2_FILE_PLAYBACK_URL_TTL_SECONDS=600
# Optional: Cloudflare R2 Custom Domain or public bucket URL for public images/assets
# (e.g. https://materials.molycourse.online or https://pub-<hash>.r2.dev)
R2_PUBLIC_DOMAIN=

# Cloudinary signed uploads for images/thumbnails (optional when R2 is enough)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo (Sendinblue) Transactional Email Service
# Lấy API key tại: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@molycourse.com
BREVO_SENDER_NAME=Moly Course

# MOLI-style quiz authoring and server-side image OCR. Keep API keys on the
# backend only; never expose them through a VITE_* variable.
MOLI_QUIZ_AUTHORING_ENABLED=false
QUIZ_OCR_ENABLED=false
QUIZ_OCR_BASE_URL=https://your-openai-compatible-provider.example.com/v1
QUIZ_OCR_API_KEYS=
QUIZ_OCR_MODEL=
QUIZ_OCR_FALLBACK_MODELS=
QUIZ_OCR_TIMEOUT_MS=120000
QUIZ_OCR_MAX_TOKENS=4500
QUIZ_OCR_RATE_LIMIT_WINDOW_MS=60000
QUIZ_OCR_RATE_LIMIT_MAX=10
QUIZ_DOCUMENT_IMPORT_ENABLED=false

# MolyPet AI assistant. Keep provider keys on the backend only.
MOLI_PET_ENABLED=false
MOLI_PET_BASE_URL=https://9router-production-d1ef.up.railway.app/v1
MOLI_PET_API_KEYS=
MOLI_PET_MODEL=ag/gemini-3-flash
MOLI_PET_FALLBACK_MODELS=ag/gemini-3.8-flash-low
MOLI_PET_TIMEOUT_MS=45000
MOLI_PET_MAX_TOKENS=3000
