{
  "name": "course_react_website",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "serve": "cross-env NODE_ENV=development nodemon --watch backend --watch database --ignore frontend --ignore frontend/node_modules ./backend/server.js",
    "dev:console:backend": "node scripts/dev-console.mjs backend",
    "dev:console:frontend": "node scripts/dev-console.mjs frontend",
    "build": "npm install && npm install --prefix frontend && npm run build --prefix frontend",
    "migrate": "node ./run_sql.js",
    "migrate:baseline": "cross-env MIGRATION_BASELINE=true node ./run_sql.js",
    "prestart": "npm run migrate",
    "preworker": "npm run migrate",
    "test:auth": "node --test backend/middleware/requireRole.test.js",
    "test:security": "node --test backend/middleware/requireRole.test.js backend/middleware/requireActiveStudentLmsAccess.test.js backend/middleware/security.test.js",
    "test:calendar": "node --test backend/services/calendarIcs.service.test.js",
    "test:assessment": "node --test backend/services/assessmentPolicy.service.test.js",
    "test:lms-workflows": "node --test backend/services/lmsWorkflow.integration.test.js",
    "test:integration": "node --test backend/middleware/requireManagementIntegration.test.js backend/services/managementSync.service.test.js",
    "worker": "cross-env NODE_ENV=production node ./backend/worker.js",
    "start": "cross-env NODE_ENV=production node ./backend/server.js"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "nodemon": "^3.1.9"
  }
}
