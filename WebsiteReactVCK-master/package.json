{
  "name": "course_react_website",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "serve": "cross-env NODE_ENV=development nodemon --watch backend --watch database --ignore frontend --ignore frontend/node_modules ./backend/server.js",
    "build": "npm install && npm install --prefix frontend && npm run build --prefix frontend",
    "test:auth": "node --test backend/middleware/requireRole.test.js",
    "test:security": "node --test backend/middleware/requireRole.test.js backend/middleware/security.test.js",
    "test:integration": "node --test backend/middleware/requireManagementIntegration.test.js backend/services/managementSync.service.test.js",
    "worker": "cross-env NODE_ENV=production node ./backend/worker.js",
    "start": "cross-env NODE_ENV=production node ./backend/server.js"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
